# Copy to .env.claude next to your project's docker-compose.claude.yml,
# fill in real values, and invoke compose with:
#   docker compose --env-file .env.claude -f docker-compose.claude.yml <cmd>
# (the non-default filename means compose won't pick it up automatically).
# Never commit the filled-in .env.claude -- it holds a real Postgres password.

# Must be unique among every project's sandbox you run at the same time
# (each project gets its own 172.100.<this>.0/24 network). Start at 0 and
# increment per additional project. Also sets the claude container's
# SELinux level (s0:c<this>,c1000), which the host-side semanage rule for
# this repo must match -- see README, "SELinux". Changing it later means
# redoing that rule.
PROJECT_NET_OCTET=0

# Absolute host path to a checkout of the sandbox template repo (the one
# this file came from). The claude image is built from its claude-code/
# directory, so a change there is picked up by every project's next
# `up -d --build`.
SANDBOX_REPO=/home/change-me/data/git/cape_fox/anthropic_containers

# ---- Toolchain baked into this project's image -------------------------
# Leave a value empty to not install that language. These are build args:
# changing one means `up -d --build` and a recreated container (which ends
# any running session). Match your project's .tool-versions /
# .ruby-version exactly -- only the baked versions exist in the sandbox.
RUBY_VERSIONS=                       # RVM; space-separated, first is default, e.g. "3.3.6 3.2.5"
ERLANG_VERSION=28.5                  # asdf-erlang; compiled from source (10-20 min, cached)
ELIXIR_VERSION=1.18.4-otp-28         # asdf-elixir; -otp-NN must match ERLANG_VERSION's major
NODEJS_VERSION=24.18.1               # asdf-nodejs
K6_VERSION=0.49.0                    # asdf-k6
# Pin to a commit SHA each for a reproducible build; empty/master = branch head.
#ASDF_ERLANG_PLUGIN_REF=
#ASDF_ELIXIR_PLUGIN_REF=
#ASDF_NODEJS_PLUGIN_REF=
#ASDF_K6_PLUGIN_REF=
# Claude Code version in the image. "latest" at build time by default.
CLAUDE_CODE_VERSION=latest
TZ=UTC

# Also a build arg: its major version picks the sandbox's pg_dump/psql client,
# so changing it means `up -d --build`.
POSTGRES_VERSION=16
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Absolute host path to your personal, cross-project CLAUDE.md. Must already
# exist as a file (an empty one is fine) or `up` fails. Keep it in a directory
# of its own, never ~/.claude: the host SELinux rule covers the whole directory
# -- see README, "SELinux: the Claude settings directories".
PERSONAL_CLAUDE_MD_PATH=/home/change-me/.claude-personal/CLAUDE.md

# Absolute host path to a directory holding managed-settings.json and
# managed-mcp.json (start from claude-code/managed/ in the template repo).
# Mounted read-only at /etc/claude-code inside the sandbox -- see README,
# "Managed settings". Can be shared by every project on the machine. Needs the
# same host SELinux rule; without it these settings are silently not applied.
CLAUDE_MANAGED_DIR=/home/change-me/.claude-sandbox/managed
