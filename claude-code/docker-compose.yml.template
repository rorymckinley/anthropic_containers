services:
  dnsmasq_change_me:
    image: claude-sandbox-dnsmasq
    container_name: dnsmasq-change-me
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    user: "1000:1000"
    tmpfs:
      - /tmp
    networks:
      anthropic_containers:
        ipv4_address: 172.100.${PROJECT_NET_OCTET}.53
      # Second leg: dnsmasq needs to reach its upstream resolver (8.8.8.8).
      egress: {}

  squid_proxy_change_me:
    image: claude-sandbox-squid
    container_name: squid-proxy-change-me
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    user: "1000:1000"
    tmpfs:
      - /tmp
      - /run
    networks:
      anthropic_containers:
        ipv4_address: 172.100.${PROJECT_NET_OCTET}.80
      # Second leg: squid opens its own upstream connection to the Anthropic
      # API from here. It is an application-layer relay, not a router --
      # ip_forward is off in its namespace and cap_drop ALL means it can't
      # be turned on -- so nothing from anthropic_containers transits.
      egress: {}

  claude_code_change_me:
    # Built per project from the template repo's Dockerfile. The base
    # layers are shared between projects via the build cache; only the
    # toolchain layers (versions below) differ. Rebuild with
    # `up -d --build` after changing any of these or to pick up a newer
    # Claude Code. Empty version = that language isn't installed.
    build:
      context: ${SANDBOX_REPO}/claude-code
      args:
        TZ: ${TZ:-UTC}
        RUBY_VERSIONS: ${RUBY_VERSIONS:-}
        ERLANG_VERSION: ${ERLANG_VERSION:-}
        ELIXIR_VERSION: ${ELIXIR_VERSION:-}
        NODEJS_VERSION: ${NODEJS_VERSION:-}
        K6_VERSION: ${K6_VERSION:-}
        POSTGRES_VERSION: ${POSTGRES_VERSION}
        CLAUDE_CODE_VERSION: ${CLAUDE_CODE_VERSION:-latest}
    image: claude-sandbox-change-me
    container_name: claude-code-change-me
    entrypoint: /bin/bash
    stdin_open: true
    tty: true
    read_only: true
    user: "1000:1000"
    dns:
      - 172.100.${PROJECT_NET_OCTET}.53
    environment:
      DISABLE_ERROR_REPORTING: "1"
      DISABLE_TELEMETRY: "1"
      # Both cases: curl/git/bundler read the lowercase ones, Node and
      # Erlang's httpc read uppercase. Postgres is on-subnet, not via squid.
      HTTP_PROXY: http://172.100.${PROJECT_NET_OCTET}.80:3128
      HTTPS_PROXY: http://172.100.${PROJECT_NET_OCTET}.80:3128
      http_proxy: http://172.100.${PROJECT_NET_OCTET}.80:3128
      https_proxy: http://172.100.${PROJECT_NET_OCTET}.80:3128
      NO_PROXY: localhost,127.0.0.1,172.100.${PROJECT_NET_OCTET}.201
      no_proxy: localhost,127.0.0.1,172.100.${PROJECT_NET_OCTET}.201
      # /tmp is a noexec tmpfs (Docker default, kept on purpose). Anything
      # that builds-and-runs in its temp dir (ruby-build, rustup) needs an
      # exec-capable one; the home volume is. /etc/bash.bashrc creates it.
      TMPDIR: /home/node/tmp
      # The toolchain is read_only in the image, so per-project packages go
      # on the home volume. BUNDLE_FROZEN turns "Gemfile.lock needs
      # updating" into a clear error instead of an EROFS on the :ro code
      # mount -- run `bundle install` on the host first, then here.
      BUNDLE_PATH: /home/node/.bundle-path
      BUNDLE_FROZEN: "true"
      MIX_DEPS_PATH: /home/node/mix/deps
      MIX_BUILD_ROOT: /home/node/mix/_build
      PGHOST: 172.100.${PROJECT_NET_OCTET}.201
      PGPORT: "5432"
      PGUSER: ${POSTGRES_USER}
      PGPASSWORD: ${POSTGRES_PASSWORD}
      PGDATABASE: ${POSTGRES_DB}
      DATABASE_URL: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@172.100.${PROJECT_NET_OCTET}.201:5432/${POSTGRES_DB}
    volumes:
      # Code mount: plain :ro, no :Z -- see README's one-time host SELinux
      # setup step, which makes :Z's mount-time-only relabel unnecessary.
      - ~/data/git/change-me:/workspace/code:ro
      # The two Claude settings mounts use the long form so a missing host
      # path stops `up` with an error. The short form makes Docker create an
      # empty root-owned directory there instead, and the sandbox then starts
      # without the settings. Both need the host labels from README,
      # "SELinux: the Claude settings directories".
      #
      # Personal, cross-project CLAUDE.md -- host path supplied per machine.
      - type: bind
        source: ${PERSONAL_CLAUDE_MD_PATH}
        target: /home/node/.claude/CLAUDE.md
        read_only: true
        bind:
          create_host_path: false
      # Managed settings tier (managed-settings.json + managed-mcp.json).
      # Read-only, host-controlled, and above everything a session can
      # write: hooks and MCP servers planted in ~/.claude/settings.json or
      # ~/.claude.json are ignored. Directory mount, not file mounts, so
      # host-side edits (even rename-saving editors) are seen immediately.
      - type: bind
        source: ${CLAUDE_MANAGED_DIR}
        target: /etc/claude-code
        read_only: true
        bind:
          create_host_path: false
      # The only persistent writable state. Note Docker seeds a named
      # volume from image content only when the volume is empty, so
      # nothing the image needs at runtime lives under /home/node (the
      # Dockerfile puts toolchains in /opt and shell wiring in /etc).
      - claude_node_home:/home/node
      # Outbox: pull model only. Claude writes here, Rory reviews inside
      # the container, then `docker cp`s out whatever he wants to keep.
      # Must be a volume, not tmpfs -- `docker cp` can't read tmpfs (see
      # README, "Outbox: pull model, not push").
      - claude_outbox:/workspace/outbox
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
      # Pin this container's SELinux MCS level instead of taking Docker's
      # random per-start categories, so the host-side file-context rule
      # for this repo can name the same level and the code mount keeps
      # per-container isolation without `:Z` -- see README, "SELinux".
      # Derived from PROJECT_NET_OCTET so it's unique per project for free.
      - "label=level:s0:c${PROJECT_NET_OCTET},c1000"
    # anthropic_containers ONLY. Never attach this service to `egress` --
    # that would hand the sandbox a direct route out, bypassing squid.
    networks:
      anthropic_containers:
        ipv4_address: 172.100.${PROJECT_NET_OCTET}.200
    tmpfs:
      - /tmp
      - /run

  postgres_change_me:
    image: postgres:${POSTGRES_VERSION}
    container_name: claude-postgres-change-me
    read_only: true
    user: "999:999"
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PGDATA: /var/lib/postgresql/data/pgdata
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      anthropic_containers:
        ipv4_address: 172.100.${PROJECT_NET_OCTET}.201
    tmpfs:
      - /tmp
      - /run
      - /var/run/postgresql
      # Ephemeral by design: data resets every time this container is
      # recreated. No named volume for Postgres data.
      - /var/lib/postgresql/data

volumes:
  claude_node_home:
  claude_outbox:

networks:
  # Private to this project -- not external, not shared with any other
  # project's stack. PROJECT_NET_OCTET (from .env.claude) just needs to be
  # unique among projects running at the same time; the last-octet
  # addresses above stay the same across every project's copy.
  #
  # This is the enforcement layer for "egress is proxy-only". Without
  # `internal: true` this is an ordinary NATed bridge and any process that
  # ignores HTTP(S)_PROXY and the resolver has the host's full network
  # reach (verified from inside a running sandbox). With it, containers
  # get no default route and the host kernel drops any forwarded packet
  # leaving the /24. The claude container can still reach dnsmasq, squid,
  # and Postgres because they're on-subnet.
  anthropic_containers:
    internal: true
    # IPv4-only, explicitly. With IPv6 enabled there'd be a second address
    # family to seal (and a gateway_mode_ipv6 to set); keeping it off is
    # simpler and matches the IPv4-shaped proxy/DNS/ACL config.
    enable_ipv6: false
    driver_opts:
      # `internal` alone still leaves the bridge's own address -- i.e. the
      # host -- reachable, since that traffic hits the host's INPUT chain
      # rather than FORWARD. `isolated` gives the bridge no address at all,
      # so there is no host endpoint on the subnet to connect to.
      # Requires Docker Engine 28+. On an older engine, remove this line
      # and instead block INPUT from the sandbox subnets with firewalld.
      com.docker.network.bridge.gateway_mode_ipv4: isolated
    ipam:
      config:
        - subnet: 172.100.${PROJECT_NET_OCTET}.0/24

  # Ordinary NATed bridge for dnsmasq and squid only -- their path to the
  # outside world. Docker-assigned subnet; nothing addresses anything on it
  # by IP. The claude and postgres services must never be attached here.
  egress:
    enable_ipv6: false
